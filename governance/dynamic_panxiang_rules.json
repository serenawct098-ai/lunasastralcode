  "auspice_judgment_matrix_吉凶判斷矩陣": {
    "principle": "吉凶由獨立抽樣的星、門、神、奇儀四值組合後依既定類別權重映射；時辰保留為獨立輸入與去重維度，不參與此映射。",
    "base_rules": [
      {
        "rule": "吉星配吉門配吉神配三奇",
        "result": "大吉格"
      },
      {
        "rule": "吉星配吉門，但遇六儀或凶神",
        "result": "中吉格（減等）"
      },
      {
        "rule": "凶星配凶門配凶神",
        "result": "大凶格"
      },
      {
        "rule": "凶星或凶門單獨出現，但與三奇比和",
        "result": "凶中帶吉（半吉半凶）"
      },
      {
        "rule": "星門宮三奇六儀之間五行相生或比和",
        "result": "吉"
      },
      {
        "rule": "星門宮三奇六儀之間五行相刑、相沖、相剋、相害、入墓",
        "result": "凶"
      }
    ],
